// For format details, see https://aka.ms/devcontainer.json.
{
    "name": "CN3S",
    "image": "cordmaur/planetary:v5",
    // "image": "cordmaur/merge-downloader:v1",
    "mounts": [
        // Bind-mount a local data folder into the container.
        // Set CN3S_DATA_FOLDER on the host to the path of your data directory.
        "source=/mnt/e/OneDrive/OneDrive - Agência Nacional de Águas/data,target=/data,type=bind"
    ],
    "runArgs": [
        "--memory=16g",
        "--memory-swap=24g"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "charliermarsh.ruff",
                "ms-python.python",
                "ms-python.mypy-type-checker",
                "ms-toolsai.jupyter"
            ]
        }
    },
    "postCreateCommand": "apt-get update && apt-get install -y libglib2.0-0 && pip install -e . --break-system-packages && pip install git+https://github.com/cordmaur/merge-downloader.git@databricks2 --break-system-packages"
    // "postCreateCommand": "pip install -e . --break-system-packages"
}
